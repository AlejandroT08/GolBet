@model MatchDto
@{
    ViewData["Title"] = $"{Model.HomeTeamName} vs {Model.AwayTeamName}";

    bool disableBetButton = Model.Status == MatchStatus.Programado;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-controller="Matches" asp-action="Index">Cartelera</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.HomeTeamName vs @Model.AwayTeamName</li>
    </ol>
</nav>

<div class="card shadow-sm match-detail-card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <span class="badge fs-6 @Model.Status.ToBadgeCssClass()">@Model.Status.ToSpanishLabel()</span>
            <span class="text-muted">@Model.MatchDate.ToString("dddd dd MMMM yyyy, hh:mm tt", new System.Globalization.CultureInfo("es-CO")) (hora Colombia)</span>
        </div>

        <div class="row align-items-center text-center mb-4">
            <div class="col-4">
                <img class="team-shield-lg"
                     src="@(string.IsNullOrEmpty(Model.HomeTeamShieldUrl) ? Url.Content("~/images/placeholder-fc.svg") : Model.HomeTeamShieldUrl)"
                     alt="Escudo @Model.HomeTeamName" />
                <h4 class="mt-2">@Model.HomeTeamName</h4>
            </div>
            <div class="col-4">
                @if (Model.Status == MatchStatus.Finalizado || Model.Status == MatchStatus.EnJuego)
                {
                    <div class="display-4 fw-bold">@Model.HomeScore - @Model.AwayScore</div>
                }
                else
                {
                    <div class="display-6 text-muted">vs</div>
                }
            </div>
            <div class="col-4">
                <img class="team-shield-lg"
                     src="@(string.IsNullOrEmpty(Model.AwayTeamShieldUrl) ? Url.Content("~/images/placeholder-fc.svg") : Model.AwayTeamShieldUrl)"
                     alt="Escudo @Model.AwayTeamName" />
                <h4 class="mt-2">@Model.AwayTeamName</h4>
            </div>
        </div>

        <hr />

        <h5 class="mb-3">Cuotas</h5>
        <div class="row text-center mb-4 g-3">
            <div class="col-md-4">
                <div class="odds-box">
                    <div class="text-muted small">Local (@Model.HomeTeamName)</div>
                    <div class="fs-3 fw-bold">@Model.HomeOdds.ToString("0.00")</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="odds-box">
                    <div class="text-muted small">Empate</div>
                    <div class="fs-3 fw-bold">@Model.DrawOdds.ToString("0.00")</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="odds-box">
                    <div class="text-muted small">Visitante (@Model.AwayTeamName)</div>
                    <div class="fs-3 fw-bold">@Model.AwayOdds.ToString("0.00")</div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted">
                🎟️ @Model.BetsCount apuesta@(Model.BetsCount == 1 ? "" : "s") registrada@(Model.BetsCount == 1 ? "" : "s")
            </span>
            <button type="button" class="btn btn-golbet" disabled="@disableBetButton">
                Apostar (Módulo 8)
            </button>
        </div>
    </div>
</div>
